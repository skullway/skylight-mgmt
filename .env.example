# Neon: pooled URL for the app at runtime (no pgbouncer=true needed with the pg adapter)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# Neon: direct, non-pooled URL for the Prisma CLI and migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Vercel cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=""

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_ID=""
WHATSAPP_TOKEN=""

# Admin auth (next-auth, phase 1)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAILS="" # comma-separated
# Local only: shows a "dev login" button on /login (ignored in production builds)
DEV_LOGIN=false
